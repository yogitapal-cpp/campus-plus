# ==========================================
# Campus Pulse — Environment Configuration
# ==========================================

# 1. Google Gemini AI API Key (Required for server-side AI parsing, summaries, and action plans)
# In AI Studio, this is injected automatically from Secrets.
# For local development or Vercel, get a free key at: https://aistudio.google.com
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# 2. Host Application URL (Automatically configured in deployment)
APP_URL="http://localhost:3000"

# 3. Supabase PostgreSQL Configuration (Optional: for cloud persistence)
# If left empty, Campus Pulse automatically uses its built-in persistent storage.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
